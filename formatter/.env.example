# ISP Ticket Formatter — environment configuration template.
# Copy to .env and fill in real values:  cp .env.example .env
# .env is gitignored so secrets are never committed.

# Host port the web UI is published on (container always listens on 8000).
HOST_PORT=8087

# Password for the /admin address-rules editor. CHANGE THIS.
ADMIN_PASSWORD=changeme

# Secret used to sign admin sessions. Set to a long random string so admin
# logins survive restarts (otherwise a random key is generated each start).
SECRET_KEY=change-this-to-a-long-random-string

# --- Znuny address / account verification (optional; disabled until set) ---
# Checks a detected address against Znuny ticket CustomerIDs (warns if not
# found) and the account against CustomerUserLogin (warns "possible relocation"
# if it already exists), via the GenericTicketConnectorREST web service.
#ZNUNY_URL=https://znuny.example.com/otrs
#ZNUNY_WEBSERVICE=GenericTicketConnectorREST
#ZNUNY_USER=your-agent-login
#ZNUNY_PASSWORD=your-agent-password
#ZNUNY_VERIFY_SSL=false
#ZNUNY_TIMEOUT=5
#ZNUNY_CACHE_TTL=60