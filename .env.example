# Dhiraagu Portal
DHIRAAGU_URL=https://afas.dhiraagu.com.mv/login
DHIRAAGU_USERNAME=your_username
DHIRAAGU_PASSWORD=your_password

# Ooredoo Portal
OOREDOO_URL=https://www.ooredoo.mv/webapps/FMS/public/tickets
OOREDOO_USERNAME=your_username
OOREDOO_PASSWORD=your_password

# ROL Portal
ROL_URL=https://support.rol.net.mv/staff/index.php
ROL_USERNAME=your_username
ROL_PASSWORD=your_password

# Medianet Portal
MEDIANET_URL=https://app.crm.com/crm/service-requests-board
MEDIANET_USERNAME=your_username
MEDIANET_PASSWORD=your_password

# Znuny API (read-only sync)
ZNUNY_URL=https://your-znuny-instance.com
ZNUNY_USERNAME=your_username
ZNUNY_PASSWORD=your_password

# Znuny ticket creation (write) - deliberately separate from the read-only creds
# above. Used by the "Create in Znuny" button on the ticket formatter page
# (admin only). Needs an agent account with ticket-create rights on the ISP
# queues. Leave unset to keep the button disabled.
ZNUNY_CREATE_URL=https://your-znuny-instance.com
ZNUNY_CREATE_USERNAME=your_write_username
ZNUNY_CREATE_PASSWORD=your_write_password

# NocBot API - ONT-exists-in-SMX lookup (see API_GUIDE.md). Ticket addresses are
# sent as the ont_id to GET /api/ont/<ont_id>.
NOCBOT_URL=http://10.241.1.107:5000
NOCBOT_API_KEY=your_nocbot_api_key

# Cloudflare bypass (FlareSolverr) - required for portals behind Cloudflare (e.g. Dhiraagu).
# Point to a running FlareSolverr instance reachable from this host, e.g.:
#   docker run -d --name flaresolverr -p 8191:8191 ghcr.io/flaresolverr/flaresolverr:latest
# Read from the environment only (not DB-backed), so it must be set here / as a real env var.
FLARESOLVERR_URL=http://localhost:8191

# Scheduler settings
EXTRACTION_INTERVAL_MINUTES=5
ZNUNY_SYNC_INTERVAL_MINUTES=3

# Dashboard settings
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000
